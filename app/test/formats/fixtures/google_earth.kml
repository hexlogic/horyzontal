<?xml version="1.0" encoding="UTF-8"?>
<kml xmlns="http://www.opengis.net/kml/2.2" xmlns:gx="http://www.google.com/kml/ext/2.2" xmlns:kml="http://www.opengis.net/kml/2.2" xmlns:atom="http://www.w3.org/2005/Atom">
<Document>
	<name>Розвідка 12.10.kmz</name>
	<StyleMap id="m_ylw-pushpin">
		<Pair>
			<key>normal</key>
			<styleUrl>#s_ylw-pushpin</styleUrl>
		</Pair>
		<Pair>
			<key>highlight</key>
			<styleUrl>#s_ylw-pushpin_hl</styleUrl>
		</Pair>
	</StyleMap>
	<Style id="s_ylw-pushpin">
		<IconStyle>
			<color>ff0000ff</color>
			<scale>1.1</scale>
			<Icon>
				<href>http://maps.google.com/mapfiles/kml/pushpin/ylw-pushpin.png</href>
			</Icon>
			<hotSpot x="20" y="2" xunits="pixels" yunits="pixels"/>
		</IconStyle>
	</Style>
	<Style id="s_ylw-pushpin_hl">
		<IconStyle>
			<color>ff00ff00</color>
		</IconStyle>
	</Style>
	<Style id="route">
		<LineStyle>
			<color>ff00aaff</color>
			<width>4</width>
		</LineStyle>
	</Style>
	<Style id="area">
		<LineStyle>
			<color>ff0000ff</color>
		</LineStyle>
		<PolyStyle>
			<color>7f0000ff</color>
		</PolyStyle>
	</Style>
	<Style id="fillonly">
		<PolyStyle>
			<color>4000ff00</color>
		</PolyStyle>
	</Style>
	<Folder>
		<name>Спостереження</name>
		<open>1</open>
		<Placemark>
			<name>Позиція міномету</name>
			<description><![CDATA[<b>Миномёт</b> 120 мм, 2 шт.]]></description>
			<LookAt>
				<longitude>37.80</longitude>
				<latitude>48.01</latitude>
				<altitude>0</altitude>
				<heading>0</heading>
				<tilt>0</tilt>
				<range>1000</range>
				<gx:altitudeMode>relativeToSeaFloor</gx:altitudeMode>
			</LookAt>
			<TimeStamp><when>2026-10-11T06:15:00Z</when></TimeStamp>
			<styleUrl>#m_ylw-pushpin</styleUrl>
			<Point>
				<gx:drawOrder>1</gx:drawOrder>
				<coordinates>37.8012345,48.0123456,0</coordinates>
			</Point>
		</Placemark>
		<Placemark>
			<name>Висота 212</name>
			<styleUrl>#m_ylw-pushpin</styleUrl>
			<Point>
				<altitudeMode>absolute</altitudeMode>
				<coordinates>37.75, 48.05, 212.4</coordinates>
			</Point>
		</Placemark>
		<Folder>
			<name>Маршрути</name>
			<Placemark>
				<name>Дорога на північ</name>
				<styleUrl>#route</styleUrl>
				<LineString>
					<tessellate>1</tessellate>
					<coordinates>
						37.70,48.00,0 37.71,48.02,0
						37.73,48.05,0
					</coordinates>
				</LineString>
			</Placemark>
			<Placemark>
				<name>Трек</name>
				<gx:Track>
					<when>2026-10-11T06:00:00Z</when>
					<gx:coord>37.7 48.0 0</gx:coord>
				</gx:Track>
			</Placemark>
		</Folder>
	</Folder>
	<Folder>
		<name>Зони</name>
		<Placemark>
			<name>Лісосмуга</name>
			<styleUrl>#area</styleUrl>
			<Polygon>
				<outerBoundaryIs>
					<LinearRing>
						<coordinates>37.6,48.1,0 37.7,48.1,0 37.7,48.2,0 37.6,48.2,0 37.6,48.1,0</coordinates>
					</LinearRing>
				</outerBoundaryIs>
				<innerBoundaryIs>
					<LinearRing>
						<coordinates>37.62,48.12,0 37.64,48.12,0 37.64,48.14,0 37.62,48.12,0</coordinates>
					</LinearRing>
				</innerBoundaryIs>
			</Polygon>
		</Placemark>
		<Placemark>
			<name>Поле</name>
			<styleUrl>#fillonly</styleUrl>
			<Polygon>
				<outerBoundaryIs>
					<LinearRing>
						<coordinates>37.5,48.1 37.55,48.1 37.55,48.15 37.5,48.1</coordinates>
					</LinearRing>
				</outerBoundaryIs>
			</Polygon>
		</Placemark>
		<Placemark>
			<name>Перехрестя і під'їзд</name>
			<MultiGeometry>
				<Point><coordinates>37.9,48.3</coordinates></Point>
				<LineString><coordinates>37.9,48.3 37.95,48.35</coordinates></LineString>
			</MultiGeometry>
		</Placemark>
		<Placemark>
			<name>Помилка</name>
			<Point><coordinates>37.9,95.3</coordinates></Point>
		</Placemark>
		<Placemark>
			<name>Без геометрії</name>
		</Placemark>
	</Folder>
	<NetworkLink>
		<name>Онлайн-шар</name>
		<Link><href>http://example.com/live.kml</href></Link>
	</NetworkLink>
</Document>
</kml>
